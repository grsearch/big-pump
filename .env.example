# Copy to .env locally. Never paste keys into chat or browser fields.
HELIUS_API_KEY=
X_BEARER_TOKEN=
# Explicit paid collection switches; default off.
ENABLE_X=false
ENABLE_WALLET_RESEARCH=false
AUTO_START=false
PORT=5010
DATA_DIR=data

# AI: only public X posts are sent to the selected provider. Default off.
ENABLE_AI=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
AI_MAX_CALLS_PER_DAY=100
# For Zhipu: AI_PROVIDER=zhipu and AI_MODEL=glm-4.5-air

# Stonk LaunchLab graduations: public discovery + Helius verification.
ENABLE_STONK=true

# Live A is OFF by default. The server owner must configure and explicitly arm it in the dashboard.
# Use a dedicated wallet. Never commit its keypair JSON or paste it into chat.
ENABLE_LIVE_TRADING=false
JUPITER_API_KEY=
JUPITER_REQUESTS_PER_SECOND=10
JUPITER_REQUESTS_PER_MINUTE=600
LIVE_WALLET_ADDRESS=
LIVE_WALLET_KEYPAIR_FILE=
# 1500 basis points = 15%. No automatic slippage escalation.
LIVE_SLIPPAGE_BPS=1500
# Fixed priority fee: 0.0003 SOL, separate from base signature fee and rent.
LIVE_PRIORITY_FEE_LAMPORTS=300000
# 0.005 SOL maximum network/priority/rent cost per transaction, excluding 0.1 SOL input.
LIVE_MAX_FEE_LAMPORTS=5000000
