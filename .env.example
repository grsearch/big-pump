# Copy to .env locally. Never paste keys into chat or browser fields.
HELIUS_API_KEY=
X_BEARER_TOKEN=
# Explicit paid collection switches; default off.
ENABLE_X=false
ENABLE_WALLET_RESEARCH=false
AUTO_START=false
PORT=5010
DATA_DIR=data

# AI: only public X posts are sent to the selected provider. Default off.
ENABLE_AI=false
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
AI_MAX_CALLS_PER_DAY=100
# For Zhipu: AI_PROVIDER=zhipu and AI_MODEL=glm-4.5-air
